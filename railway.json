{
  "$schema": "https://railway.app/railway.schema.json",
  "deploy": {
    "startCommand": "sh -c 'gunicorn dfinans_live_backend:app --bind 0.0.0.0:${PORT:-5055} --worker-class gthread --workers 1 --threads 16 --timeout 30'"
  },
  "services": {
    "backend": {
      "build": {
        "dockerfile": "Dockerfile"
      },
      "port": 5055
    },
    "ibkr-gateway": {
      "build": {
        "dockerfile": "ibgateway.Dockerfile"
      },
      "port": 4001,
      "environment": {
        "TWSUSER": "${IBKR_USERID}",
        "TWSPASS": "${IBKR_PASSWORD}",
        "TRADING_MODE": "live"
      }
    }
  }
}
